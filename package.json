    "@tailwindcss/vite": "latest",
    "@testing-library/vue": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vitest/coverage-v8": "latest",
    "@vue/test-utils": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "eslint": "latest",
    "happy-dom": "latest",
    "husky": "latest",
    "lucide-vue-next": "latest",
    "playwright": "latest",
    "postcss": "latest",
    "shadcn-vue": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
